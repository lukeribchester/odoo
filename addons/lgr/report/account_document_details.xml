<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Accounting owns the field selection, conditions, translatable wording,
        and formatting. The external layout only decides where this trusted
        body-form QWeb fragment is displayed.
    -->
    <template id="account_move_document_details"
              name="LGR Accounting Document Details">
        <t t-set="lgr_has_document_number" t-value="o.name and o.name != '/'"/>
        <t t-set="lgr_is_debit_note"
           t-value="o.move_type == 'out_invoice' and 'debit_origin_id' in o and o.debit_origin_id"/>
        <t t-set="lgr_has_due_date"
           t-value="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'"/>
        <t t-set="lgr_has_taxable_supply_date"
           t-value="o.taxable_supply_date and o.show_taxable_supply_date"/>
        <t t-set="lgr_has_source"
           t-value="o.invoice_origin and o.move_type in ('out_invoice', 'out_refund', 'out_receipt')"/>
        <t t-if="lgr_has_document_number
                 or o.invoice_date
                 or lgr_has_due_date
                 or o.delivery_date
                 or lgr_has_taxable_supply_date
                 or lgr_has_source
                 or o.partner_id.ref
                 or o.ref
                 or o.invoice_incoterm_id">
            <table class="table-borderless w-100 o_ignore_layout_styling o_lgr_structural_table o_lgr_key_value_table o_lgr_document_details_table">
                <colgroup>
                    <col style="width: 20%;"/>
                    <col style="width: 80%;"/>
                </colgroup>
                <tbody>
                    <tr t-if="lgr_has_document_number">
                        <td class="o_lgr_document_detail_label">
                            <strong>
                                <t t-if="lgr_is_debit_note">Debit Note Number</t>
                                <t t-elif="o.move_type == 'out_invoice'">Invoice Number</t>
                                <t t-elif="o.move_type in ('out_refund', 'in_refund')">Credit Note Number</t>
                                <t t-elif="o.move_type in ('out_receipt', 'in_receipt')">Receipt Number</t>
                                <t t-elif="proforma and o.move_type == 'in_invoice'">Bill Number</t>
                                <t t-elif="o.move_type == 'in_invoice' and o.journal_id.is_self_billing">Invoice
                                    Number
                                </t>
                                <t t-elif="o.move_type == 'in_invoice'">Bill Number</t>
                            </strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.name">INV/2026/00001</span>
                        </td>
                    </tr>

                    <tr t-if="o.invoice_date">
                        <td class="o_lgr_document_detail_label">
                            <strong>
                                <t t-if="lgr_is_debit_note">Debit Note Date</t>
                                <t t-elif="o.move_type == 'out_invoice'">Invoice Date</t>
                                <t t-elif="o.move_type in ('out_refund', 'in_refund')">Credit Note Date</t>
                                <t t-elif="o.move_type in ('out_receipt', 'in_receipt')">Receipt Date</t>
                                <t t-elif="proforma and o.move_type == 'in_invoice'">Bill Date</t>
                                <t t-elif="o.move_type == 'in_invoice' and o.journal_id.is_self_billing">Invoice Date
                                </t>
                                <t t-elif="o.move_type == 'in_invoice'">Bill Date</t>
                            </strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.invoice_date"
                                  t-options='{"widget": "date", "format": "d MMMM yyyy"}'>18 August 2026
                            </span>
                        </td>
                    </tr>

                    <tr t-if="lgr_has_due_date">
                        <td class="o_lgr_document_detail_label">
                            <strong>Due Date</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.invoice_date_due"
                                  t-options='{"widget": "date", "format": "d MMMM yyyy"}'>17 September 2026
                            </span>
                        </td>
                    </tr>

                    <tr t-if="o.delivery_date">
                        <td class="o_lgr_document_detail_label">
                            <strong>Delivery Date</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.delivery_date"
                                  t-options='{"widget": "date", "format": "d MMMM yyyy"}'>18 August 2026
                            </span>
                        </td>
                    </tr>

                    <tr t-if="lgr_has_taxable_supply_date">
                        <td class="o_lgr_document_detail_label">
                            <strong>Taxable Supply</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.taxable_supply_date"
                                  t-options='{"widget": "date", "format": "d MMMM yyyy"}'>18 August 2026
                            </span>
                        </td>
                    </tr>

                    <tr t-if="lgr_has_source">
                        <td class="o_lgr_document_detail_label">
                            <strong>Source</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.invoice_origin">SO123</span>
                        </td>
                    </tr>

                    <tr t-if="o.partner_id.ref">
                        <td class="o_lgr_document_detail_label">
                            <strong>
                                <t t-if="o.move_type in ('out_invoice', 'out_refund', 'out_receipt')">Customer Code</t>
                                <t t-else="">Vendor Code</t>
                            </strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.partner_id.ref">CUST-001</span>
                        </td>
                    </tr>

                    <tr t-if="o.ref">
                        <td class="o_lgr_document_detail_label">
                            <strong>Reference</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <span t-field="o.ref">PO-2026-001</span>
                        </td>
                    </tr>

                    <tr t-if="o.invoice_incoterm_id">
                        <td class="o_lgr_document_detail_label">
                            <strong>Incoterm</strong>
                        </td>
                        <td class="o_lgr_document_detail_value">
                            <t t-if="o.incoterm_location">
                                <span t-field="o.invoice_incoterm_id.code">FCA</span>
                                <br/>
                                <span t-field="o.incoterm_location">Amsterdam</span>
                            </t>
                            <span t-else="" t-field="o.invoice_incoterm_id.code">FCA</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <!--
        This is an extension of Odoo's invoice view, not a replacement report.
        Other layouts ignore the extra call argument.
    -->
    <template id="report_invoice_document_lgr_details"
              inherit_id="account.report_invoice_document">
        <t t-call="web.external_layout" position="before">
            <t t-set="lgr_document_details">
                <t t-call="lgr.account_move_document_details"/>
            </t>
        </t>
        <t t-call="web.external_layout" position="attributes">
            <attribute name="lgr_document_details">lgr_document_details</attribute>
        </t>
    </template>

    <!--
        The visible LGR masthead participates in the article flow, so an
        all-LGR PDF batch can use a compact top margin and no header spacing.
        Mixed and non-LGR batches retain the values supplied by the renderer.
    -->
    <template id="report_invoice_lgr_header_margins"
              inherit_id="account.report_invoice">
        <t t-call="web.html_container" position="before">
            <t t-set="lgr_all_documents_use_lgr"
               t-value="bool(docs) and all(
                   document.company_id.external_report_layout_id
                   and document.company_id.external_report_layout_id.sudo().key == 'lgr.external_layout_lgr'
                   for document in docs
               )"/>
        </t>
        <t t-call="web.html_container" position="attributes">
            <attribute name="data_report_margin_top">11 if lgr_all_documents_use_lgr else data_report_margin_top
            </attribute>
            <attribute name="data_report_header_spacing">'0' if lgr_all_documents_use_lgr else
                data_report_header_spacing
            </attribute>
        </t>
    </template>
</odoo>
