<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A distinct primary template gives LGR a stable invoice-design surface
        while retaining Odoo's resolved default invoice architecture.
    -->
    <template id="report_invoice_document"
              name="LGR Invoice Document"
              inherit_id="account.report_invoice_document"
              primary="True"/>

    <!--
        Route only Odoo's standard invoice-document branch through LGR. Country
        modules that add their own dispatcher branches remain unchanged.
    -->
    <template id="report_invoice_use_lgr_document"
              name="Use LGR Invoice Document"
              inherit_id="account.report_invoice"
              priority="99">
        <xpath expr="//t[@t-if=&quot;o._get_name_invoice_report() == 'account.report_invoice_document'&quot; and @t-call='account.report_invoice_document']"
               position="attributes">
            <attribute name="t-call">lgr.report_invoice_document</attribute>
        </xpath>
    </template>
</odoo>
